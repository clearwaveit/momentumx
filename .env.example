# Copy to .env.local for local testing; set the same keys in the hosting environment.

# Public site address, no trailing slash. Used for canonical URLs, sitemap.xml,
# robots.txt, share previews and the contact form's allowed-origin check.
NEXT_PUBLIC_SITE_URL=https://momentumxme.com

# Brevo transactional email (Brevo > SMTP & API > API keys).
BREVO_API_KEY=
# Sender address verified in Brevo (Senders, domains & dedicated IPs).
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=MomentumX

# Inbox that receives contact form enquiries.
TO_EMAIL=

# Set to "true" only when the app runs behind a proxy/CDN that sets
# X-Forwarded-For (Vercel, Cloudflare, nginx). Enables per-IP rate limiting.
TRUST_PROXY=true
